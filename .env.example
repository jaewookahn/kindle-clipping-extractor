# Kindle Clipping Extractor — 환경변수 설정
# 이 파일을 복사해 .env 로 저장하고 값을 채워 넣으세요.
# cp .env.example .env

# ─── Notion 연동 (필수) ───────────────────────────────────────────
# Notion integration 토큰 (https://www.notion.so/profile/integrations)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 동기화 대상 Notion 데이터베이스 ID (32자 hex, URL에서 추출)
# 예: https://notion.so/workspace/abc123...def456?v=... → abc123...def456
NOTION_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 선택 옵션 ────────────────────────────────────────────────────
# TUI 표지 이미지 렌더러 강제 지정 (기본: 자동 감지)
# 값: auto | halfcell | sixel | kitty
# KINDLE_TUI_IMAGE=auto

# tqdm 진행 표시 바 비활성화 (기본: 표시)
# 값: 1 | true | yes
# TQDM_DISABLE=
